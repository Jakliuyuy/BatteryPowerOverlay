<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="实时功率 = 电流 × 电压 ｜ 全透明悬浮窗 + 状态栏 Hook"
            android:textSize="12sp"
            android:textColor="#888888" />

        <!-- 悬浮窗开关 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/overlay_switch"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全透明无背景，拖动可移动，位置自动记忆"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 悬浮窗设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="悬浮窗设置"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/refresh_label"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinner_refresh"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/show_label"
            android:textSize="13sp"
            android:textStyle="bold" />
        <CheckBox android:id="@+id/cb_power" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/show_power" />
        <CheckBox android:id="@+id/cb_current" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/show_current" />
        <CheckBox android:id="@+id/cb_voltage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/show_voltage" />
        <CheckBox android:id="@+id/cb_temp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/show_temp" />
        <CheckBox android:id="@+id/cb_level" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/show_level" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="文字颜色"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/color_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_size_label"
                android:textSize="13sp"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/seek_text_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="10" />
            <TextView
                android:id="@+id/tv_text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字体 14sp" />
        </LinearLayout>

        <!-- Hook 模式设置 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="状态栏 Hook 设置（LSPosed）"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="显示位置"
            android:textSize="13sp"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/radio_hook_side"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_hook_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时钟右侧" />
            <RadioButton
                android:id="@+id/rb_hook_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="时钟左侧" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="显示内容"
            android:textSize="13sp"
            android:textStyle="bold" />
        <CheckBox android:id="@+id/cb_hook_power" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="功率 (W)" />
        <CheckBox android:id="@+id/cb_hook_current" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="电流 (mA)" />
        <CheckBox android:id="@+id/cb_hook_voltage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="电压 (V)" />
        <CheckBox android:id="@+id/cb_hook_temp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="温度 (°C)" />
        <CheckBox android:id="@+id/cb_hook_level" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="电量 (%)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="文字颜色"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/color_row_hook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号"
                android:textSize="13sp"
                android:textStyle="bold" />
            <SeekBar
                android:id="@+id/seek_hook_text_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="10" />
            <TextView
                android:id="@+id/tv_hook_text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号 11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hook_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="30dp"
            android:textSize="12sp"
            android:textColor="#666666" />

    </LinearLayout>
</ScrollView>
